pipeline {
    agent none
    options { timeout(time:30, unit: 'MINUTES') }
    environment {
        REGISTRY = 'ACCOUNT_ID.dkr.ecr.eu-west-2.amazonaws.com'
        IMAGE = "${REGISTRY}/demo-app"
    }
    stages {
        stage('Build per architecture') {
            parallel {
                stage('arm64')
            }
        }
    }
}