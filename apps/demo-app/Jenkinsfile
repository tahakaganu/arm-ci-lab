pipeline {
  agent { label 'linux && arm64' }
  options {
    timeout(time: 20, unit: 'MINUTES')
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }
  environment { ARTIFACTS_BUCKET = 'arm-ci-lab-artifacts-100c1f4a' }
  stages {
    stage('Install') {
      steps {
        dir('apps/demo-app') {
          sh 'python3 -m venv .venv && .venv/bin/pip install -q -r requirements.txt'
        }
      }
    }
    stage('Checks') {
      parallel {
        stage('Lint') {
          steps {
            dir('apps/demo-app') { sh '.venv/bin/pylint app.py' }
          }
        }
        stage('Unit Tests') {
          steps {
            dir('apps/demo-app') {
              sh '.venv/bin/pytest test_app.py --junitxml=reports/junit.xml'
            }
          }
        }
      }
    }
    stage('Push artifact') {
      when { expression { env.GIT_BRANCH == 'origin/main' } }
      steps {
        dir('apps/demo-app') {
          sh '''
            tar czf demo-app-${BUILD_NUMBER}.tar.gz app.py
            aws s3 cp demo-app-${BUILD_NUMBER}.tar.gz s3://${ARTIFACTS_BUCKET}/demo-app/
          '''
        }
      }
    }
    stage('Use a secret') {
      steps {
        withCredentials([string(cred
