@Library('ci-shared-lib@v1.0.1') _
pipeline {
    agent { label'linux && arm64' }
    options {
        timeout(time: 20, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    stages {
        stage('Checks') { steps { pythonCheck(dir: 'apps/demo-app') } }
        stage('Publish') {
            steps {
                dir('apps/demo-app') { sh 'tar czf demo-app-${BUILD_NUMBER}.tgz app.py'}
                publishToS3(bucket: 'arm-ci-lab-artifacts-ab1604ed', file: "apps/demo-app/demo-app-${BUILD_NUMBER}.tgz", prefix: 'demo-app')
            }
        }
    }
    post { always { junit allowEmptyResults: true, testResults: 'apps/demo-app/reports/*.xml' } }
}